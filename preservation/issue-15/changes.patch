@@ -0,0 +1,541 @@
+// SPDX-License-Identifier: MIT
+// Port of prime-agent's packages/coding-agent/src/core/refinement/refinement.ts
+// Adapted for dreb (@dreb/* packages instead of @earendil-works/pi-*)
+
+import { existsSync, mkdirSync, readFileSync, statSync } from "node:fs";
+import { join } from "node:path";
+import type { Model, Api, Context } from "@dreb/ai";
+import { completeSimple } from "@dreb/ai";
+
+const HARNESS_STATE_DIR_NAME = "harness";
+const REFINEMENT_HISTORY_FILE_NAME = "refinements.jsonl";
+
+// ── Types ───────────────────────────────────────────────────────────────────
+
+export type RefinementKind = "prompt" | "memory" | "skill" | "subagent";
+export type RefinementAction = "create" | "update" | "delete";
+export type HarnessScope = "local" | "global";
+
+export interface HarnessEntry {
+	id: string;
+	kind: RefinementKind;
+	title: string;
+	content: string;
+	path: string;
+	scope?: HarnessScope;
+	reference: Record<string, unknown>;
+	arguments: Record<string, unknown>;
+	metadata: Record<string, unknown>;
+	source: string;
+	created_at: string;
+	updated_at: string;
+	version: number;
+}
+
+export interface HarnessRefinementEvent {
+	id: string;
+	trigger: string;
+	changes: string[];
+	evidence: string;
+	outcome: string;
+	created_at: string;
+}
+
+export interface HarnessState {
+	schema: number;
+	entries: Record<RefinementKind, Record<string, HarnessEntry>>;
+	refinements: HarnessRefinementEvent[];
+}
+
+export interface RefinementEdit {
+	action: RefinementAction;
+	kind: RefinementKind;
+	id?: string;
+	title?: string;
+	content?: string;
+	path?: string;
+	reference?: Record<string, unknown>;
+	arguments?: Record<string, unknown>;
+	metadata?: Record<string, unknown>;
+	reason?: string;
+}
+
+export interface RefinementProposal {
+	summary: string;
+	rationale: string;
+	expectedOutcome: string;
+	edits: RefinementEdit[];
+}
+
+export interface AppliedRefinementEdit extends RefinementEdit {
+	id: string;
+	before?: HarnessEntry;
+	after?: HarnessEntry;
+	applied: boolean;
+	error?: string;
+}
+
+export interface RefinementResult {
+	id: string;
+	summary: string;
+	rationale: string;
+	expectedOutcome: string;
+	appliedEdits: AppliedRefinementEdit[];
+	harnessStatePath: string;
+	rollbackOf?: string;
+	scope?: HarnessScope;
+}
+
+export interface RefineOptions {
+	instructions?: string;
+	rollbackId?: string;
+	global?: boolean;
+}
+
+export interface RefinementPlan {
+	proposal: RefinementProposal;
+	id: string;
+	rollbackOf?: string;
+	rollbackScope?: HarnessScope;
+	baselineState?: HarnessState;
+}
+
+// ── Utility ─────────────────────────────────────────────────────────────────
+
+function now(): string {
+	return new Date().toISOString();
+}
+
+function slug(raw: string, fallback: string): string {
+	const normalized = raw.trim().toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "").slice(0, 80);
+	return normalized || fallback;
+}
+
+function cloneEntry(entry: HarnessEntry | undefined): HarnessEntry | undefined {
+	return entry ? JSON.parse(JSON.stringify(entry)) : undefined;
+}
+
+function emptyHarnessState(): HarnessState {
+	return {
+		schema: 1,
+		entries: { prompt: {}, memory: {}, skill: {}, subagent: {} },
+		refinements: [],
+	};
+}
+
+// ── Persistence ─────────────────────────────────────────────────────────────
+
+export function getHarnessStateDir(baseDir: string): string {
+	return join(baseDir, HARNESS_STATE_DIR_NAME);
+}
+
+export function getHarnessStatePath(dir: string): string {
+	return join(dir, "harness_state.json");
+}
+
+export function loadHarnessState(dir: string, scope: HarnessScope = "global"): HarnessState {
+	const statePath = getHarnessStatePath(dir);
+	if (!existsSync(statePath)) return emptyHarnessState();
+
+	try {
+		const raw = JSON.parse(readFileSync(statePath, "utf8"));
+		if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+			return emptyHarnessState();
+		}
+		const state = emptyHarnessState();
+		state.schema = typeof raw.schema === "number" ? raw.schema : 1;
+		if (raw.entries && typeof raw.entries === "object") {
+			for (const kind of ["prompt", "memory", "skill", "subagent"] as RefinementKind[]) {
+				const records = (raw.entries as Record<string, unknown>)[kind];
+				if (records && typeof records === "object") {
+					for (const [id, entry] of Object.entries(records as Record<string, unknown>)) {
+						if (typeof entry === "object" && entry !== null) {
+							const e = entry as Record<string, unknown>;
+							state.entries[kind][id] = {
+								id,
+								kind,
+								title: String(e.title ?? id),
+								content: String(e.content ?? ""),
+								path: String(e.path ?? "general"),
+								scope: e.scope === "global" || e.scope === "local" ? e.scope : scope,
+								reference: typeof e.reference === "object" && e.reference !== null ? e.reference as Record<string, unknown> : {},
+								arguments: typeof e.arguments === "object" && e.arguments !== null ? e.arguments as Record<string, unknown> : {},
+								metadata: typeof e.metadata === "object" && e.metadata !== null ? e.metadata as Record<string, unknown> : {},
+								source: String(e.source ?? ""),
+								created_at: String(e.created_at ?? now()),
+								updated_at: String(e.updated_at ?? now()),
+								version: typeof e.version === "number" ? e.version : 1,
+							};
+						}
+					}
+				}
+			}
+		}
+		if (Array.isArray(raw.refinements)) state.refinements = raw.refinements;
+		return state;
+	} catch {
+		return emptyHarnessState();
+	}
+}
+
+export function saveHarnessState(dir: string, state: HarnessState): string {
+	const statePath = getHarnessStatePath(dir);
+	mkdirSync(dir, { recursive: true });
+	const json = JSON.stringify(state, null, 2) + "\n";
+	require("fs").writeFileSync(statePath, json, { mode: 0o600 });
+	return statePath;
+}
+
+export function mergeHarnessStates(global: HarnessState, local?: HarnessState): HarnessState {
+	const merged = emptyHarnessState();
+	merged.schema = Math.max(global.schema, local?.schema ?? 1);
+	for (const kind of Object.keys(merged.entries) as RefinementKind[]) {
+		for (const [id, entry] of Object.entries(global.entries[kind])) {
+			merged.entries[kind][id] = { ...cloneEntry(entry)!, scope: "global" };
+		}
+		for (const [id, entry] of Object.entries(local?.entries[kind] ?? {})) {
+			const scoped = { ...cloneEntry(entry)!, scope: "local" as HarnessScope };
+			const mergedId = merged.entries[kind][id] ? `local:${id}` : id;
+			merged.entries[kind][mergedId] = scoped;
+		}
+	}
+	merged.refinements = [...global.refinements, ...(local?.refinements ?? [])];
+	return merged;
+}
+
+// ── Prompt formatting ───────────────────────────────────────────────────────
+
+function compactText(text: string, maxLength: number): string {
+	const n = text.replace(/\s+/g, " ").trim();
+	return n.length <= maxLength ? n : `${n.slice(0, maxLength - 3)}...`;
+}
+
+function overviewForPrompt(state: HarnessState): string {
+	const lines: string[] = [];
+	for (const kind of Object.keys(state.entries) as RefinementKind[]) {
+		const entries = Object.values(state.entries[kind]);
+		lines.push(`${kind}: ${entries.length}`);
+		for (const entry of entries.slice(0, 40)) {
+			lines.push(`- [${entry.scope ?? "global"}:${entry.id}] ${entry.title} (${entry.path}, v${entry.version}): ${compactText(entry.content, 240)}`);
+		}
+		if (entries.length > 40) lines.push(`- +${entries.length - 40} more ${kind} entries`);
+	}
+	return lines.join("\n");
+}
+
+function historyForPrompt(history: RefinementResult[]): string {
+	if (history.length === 0) return "No prior refinement history.";
+	return history.slice(-20)
+		.map((item) => {
+			const edits = item.appliedEdits.map((e) => `${e.applied ? "applied" : "failed"} ${e.action} ${e.kind}:${e.id}`).join(", ");
+			const rb = item.rollbackOf ? ` rollbackOf=${item.rollbackOf}` : "";
+			return `[${item.id}]${rb} ${item.summary}\n${edits}\nExpected: ${item.expectedOutcome}`;
+		})
+		.join("\n\n");
+}
+
+export function formatHarnessStateForPrompt(
+	state: HarnessState,
+	options: { maxEntriesPerKind?: number; maxRefinements?: number; maxContentLength?: number; queryTerms?: Map<string, number> } = {},
+): string {
+	const maxEntries = options.maxEntriesPerKind ?? 6;
+	const maxRef = options.maxRefinements ?? 5;
+	const maxLen = options.maxContentLength ?? 180;
+	const lines: string[] = [
+		"# Continual Harness State",
+		"",
+		"Editable supplemental prompts, memories, skills, and subagent specs. Local entries belong to this session. Global entries persist across sessions.",
+		"Use these when relevant. The base system prompt is immutable; prompt entries are supplemental notes only.",
+		"",
+		"When to refine: after a repeated failure, a reusable tactic emerges, a user corrects behavior that should persist, or a skill/memory/note should be created, updated, or deleted.",
+		"",
+	];
+
+	for (const kind of Object.keys(state.entries) as RefinementKind[]) {
+		const entries = Object.values(state.entries[kind]);
+		lines.push(`${kind}: ${entries.length}`);
+		for (const entry of entries.slice(0, maxEntries)) {
+			lines.push(`- [${entry.scope ?? "global"}:${entry.id}] ${entry.title}: ${compactText(entry.content, maxLen)}`);
+		}
+		if (entries.length > maxEntries) lines.push(`- +${entries.length - maxEntries} more ${kind} entries`);
+		lines.push("");
+	}
+
+	lines.push(`recent refinements: ${state.refinements.length}`);
+	for (const event of state.refinements.slice(-maxRef)) {
+		lines.push(`- [${event.id}] ${compactText(event.trigger, maxLen)}: ${event.changes.join(", ")}`);
+	}
+
+	return lines.join("\n").trim();
+}
+
+// ── JSON extraction ─────────────────────────────────────────────────────────
+
+function isIncompleteJson(candidate: string): boolean {
+	let depth = 0, inString = false, escaped = false;
+	for (const char of candidate) {
+		if (escaped) { escaped = false; continue; }
+		if (inString) {
+			if (char === "\\") escaped = true;
+			else if (char === '"') inString = false;
+			continue;
+		}
+		if (char === '"') inString = true;
+		else if (char === "{" || char === "[") depth++;
+		else if (char === "}" || char === "]") depth--;
+	}
+	return inString || depth > 0;
+}
+
+function extractJsonObject(text: string): unknown {
+	const trimmed = text.trim();
+	if (trimmed.startsWith("{") && trimmed.endsWith("}")) {
+		return JSON.parse(trimmed);
+	}
+	const fenced = trimmed.match(/```(?:json)?\s*([\s\S]*?)```/);
+	if (fenced) return JSON.parse(fenced[1].trim());
+
+	const start = trimmed.indexOf("{");
+	const end = trimmed.lastIndexOf("}");
+	if (start !== -1 && end > start) return JSON.parse(trimmed.slice(start, end + 1));
+	if (isIncompleteJson(trimmed)) throw new Error("Model output truncated — output budget exhausted");
+	throw new Error("Model did not return a JSON object");
+}
+
+function parseProposal(text: string): RefinementProposal {
+	const value = extractJsonObject(text) as Record<string, unknown>;
+	const edits = Array.isArray(value.edits) ? value.edits : [];
+	return {
+		summary: String(value.summary ?? "Refined harness state"),
+		rationale: String(value.rationale ?? ""),
+		expectedOutcome: String(value.expectedOutcome ?? ""),
+		edits: edits
+			.filter((e): e is Record<string, unknown> => typeof e === "object" && e !== null)
+			.map((e) => ({
+				action: e.action as RefinementAction,
+				kind: e.kind as RefinementKind,
+				id: typeof e.id === "string" ? e.id : undefined,
+				title: typeof e.title === "string" ? e.title : undefined,
+				content: typeof e.content === "string" ? e.content : undefined,
+				path: typeof e.path === "string" ? e.path : undefined,
+				reference: typeof e.reference === "object" ? e.reference as Record<string, unknown> : undefined,
+				arguments: typeof e.arguments === "object" ? e.arguments as Record<string, unknown> : undefined,
+				metadata: typeof e.metadata === "object" ? e.metadata as Record<string, unknown> : undefined,
+				reason: typeof e.reason === "string" ? e.reason : undefined,
+			})),
+	};
+}
+
+// ── Validation & Application ────────────────────────────────────────────────
+
+function validateEdit(edit: RefinementEdit): string | undefined {
+	if (!["create", "update", "delete"].includes(edit.action)) return `unsupported action: ${edit.action}`;
+	if (!["prompt", "memory", "skill", "subagent"].includes(edit.kind)) return `unsupported kind: ${edit.kind}`;
+	if (edit.id === "base_system_prompt") return "base system prompt is not editable";
+	if (edit.action !== "create" && !edit.id) return `${edit.action} requires id`;
+	if (edit.action !== "delete" && (!edit.title || !edit.content)) return `${edit.action} requires title and content`;
+	return undefined;
+}
+
+export function applyRefinementProposal(
+	state: HarnessState,
+	proposal: RefinementProposal,
+	options: { id: string; rollbackOf?: string; scope?: HarnessScope; baselineState?: HarnessState },
+): RefinementResult {
+	const appliedEdits: AppliedRefinementEdit[] = [];
+	const modifiedKeys = new Set<string>();
+
+	for (const edit of proposal.edits) {
+		const computedId = edit.id ?? (edit.action === "create" ? slug(edit.title ?? edit.kind, edit.kind) : undefined);
+		const id = computedId ?? "";
+		const err = validateEdit(edit);
+		if (err) { appliedEdits.push({ ...edit, id, applied: false, error: err }); continue; }
+
+		const records = state.entries[edit.kind];
+		const before = cloneEntry(records[id]);
+		const key = `${edit.kind}:${id}`;
+		const baseline = cloneEntry(options.baselineState?.entries[edit.kind][id]);
+
+		if (options.baselineState && !modifiedKeys.has(key) && JSON.stringify(before) !== JSON.stringify(baseline)) {
+			appliedEdits.push({ ...edit, id, before, applied: false, error: "entry changed during planning" });
+			continue;
+		}
+
+		if (edit.action === "delete") {
+			if (!before) { appliedEdits.push({ ...edit, id, applied: false, error: "entry not found" }); continue; }
+			delete records[id];
+			modifiedKeys.add(key);
+			appliedEdits.push({ ...edit, id, before, applied: true });
+			continue;
+		}
+
+		if (edit.action === "create" && before) {
+			appliedEdits.push({ ...edit, id, before, applied: false, error: "entry already exists" });
+			continue;
+		}
+		if (edit.action === "update" && !before) {
+			appliedEdits.push({ ...edit, id, applied: false, error: "entry not found" });
+			continue;
+		}
+
+		const after: HarnessEntry = {
+			id, kind: edit.kind, title: edit.title ?? before?.title ?? id,
+			content: edit.content ?? before?.content ?? "",
+			path: edit.path ?? before?.path ?? "general",
+			scope: before?.scope ?? options.scope ?? "local",
+			reference: edit.reference ?? before?.reference ?? {},
+			arguments: edit.arguments ?? before?.arguments ?? {},
+			metadata: edit.metadata ?? before?.metadata ?? {},
+			source: "refine", created_at: before?.created_at ?? now(), updated_at: now(),
+			version: before ? before.version + 1 : 1,
+		};
+		records[id] = after;
+		modifiedKeys.add(key);
+		appliedEdits.push({ ...edit, id, before, after: cloneEntry(after), applied: true });
+	}
+
+	const changes = appliedEdits.filter((e) => e.applied).map((e) => `${e.action} ${e.kind}:${e.id}`);
+	state.refinements.push({
+		id: options.id, trigger: proposal.summary, changes, evidence: proposal.rationale,
+		outcome: proposal.expectedOutcome, created_at: now(),
+	});
+
+	return {
+		id: options.id, summary: proposal.summary, rationale: proposal.rationale,
+		expectedOutcome: proposal.expectedOutcome, appliedEdits, harnessStatePath: "",
+		rollbackOf: options.rollbackOf, scope: options.scope,
+	};
+}
+
+function rollbackProposal(target: RefinementResult): RefinementProposal {
+	const edits: RefinementEdit[] = [];
+	for (const edit of [...target.appliedEdits].reverse()) {
+		if (!edit.applied) continue;
+		if (edit.before) {
+			edits.push({ action: edit.after ? "update" : "create", kind: edit.kind, id: edit.id,
+				title: edit.before.title, content: edit.before.content, path: edit.before.path,
+				reference: edit.before.reference, arguments: edit.before.arguments, metadata: edit.before.metadata,
+				reason: `Rollback ${target.id}` });
+		} else if (edit.after) {
+			edits.push({ action: "delete", kind: edit.kind, id: edit.id, reason: `Rollback ${target.id}` });
+		}
+	}
+	return { summary: `Rollback ${target.id}`, rationale: `Restores state from ${target.id}.`,
+		expectedOutcome: "Reverted.", edits };
+}
+
+// ── LLM system prompts ──────────────────────────────────────────────────────
+
+const REFINEMENT_SYSTEM_PROMPT = `You are dreb's /refine continual harness subsystem.
+Improve the editable harness state from the current trajectory.
+Emit Create, Update, or Delete edits to reusable state — prompt notes, memories, skills, and subagent specs.
+
+Components:
+- prompt: supplemental notes. The base system prompt is immutable.
+- memory: durable facts, decisions, preferences, outcomes.
+- skill: reusable procedures with reference and arguments.
+- subagent: reusable delegation specs.
+
+Scope:
+- local: session-specific progress, task state, temporary blockers. Default.
+- global: cross-session lessons, durable preferences, reusable skills/subagents.
+
+Use the trajectory, current state, and prior history. Prefer small evidence-backed edits.
+Output JSON only:
+
+{
+  "summary": "one sentence",
+  "rationale": "evidence for edits",
+  "expectedOutcome": "what improves and how to validate",
+  "edits": [{
+    "action": "create|update|delete",
+    "kind": "prompt|memory|skill|subagent",
+    "id": "stable id", "title": "...", "content": "...", "path": "grouping",
+    "reference": {}, "arguments": {}, "metadata": {}, "reason": "..."
+  }]
+}`;
+
+// ── API: plan → apply ───────────────────────────────────────────────────────
+
+export function generateRefinementId(): string {
+	return `refine_${new Date().toISOString().replace(/[^0-9]/g, "").slice(0, 17)}`;
+}
+
+/**
+ * Simple conversation serializer: joins message content into a string.
+ * For production use, replace with dreb's compaction serializer.
+ */
+function serializeConversation(messages: Array<{ role: string; content: unknown }>): string {
+	return messages.map((m) => {
+		const text = typeof m.content === "string" ? m.content
+			: Array.isArray(m.content) ? m.content.map((c: { text?: string }) => c.text ?? "").join(" ")
+			: JSON.stringify(m.content);
+		return `[${m.role}] ${text}`;
+	}).join("\n");
+}
+
+export async function planRefinement(
+	messages: Array<{ role: string; content: unknown }>,
+	state: HarnessState,
+	history: RefinementResult[],
+	model: Model<Api>,
+	options: RefineOptions = {},
+): Promise<RefinementPlan> {
+	const id = generateRefinementId();
+
+	if (options.rollbackId) {
+		const target = history.find((item) => item.id === options.rollbackId);
+		if (!target) throw new Error(`Refinement ${options.rollbackId} not found`);
+		return { proposal: rollbackProposal(target), id, rollbackOf: target.id, rollbackScope: target.scope ?? "local" };
+	}
+
+	const conversationText = serializeConversation(messages).slice(-80000);
+	const scopeInst = options.global
+		? "Scope: global. Only durable cross-session lessons, reusable skills/subagents, or project-qualified facts."
+		: "Scope: local. Session-specific progress, task state, temporary blockers.";
+
+	const userPrompt = [
+		`<current_harness>\n${overviewForPrompt(state)}\n</current_harness>`,
+		`<refinement_history>\n${historyForPrompt(history)}\n</refinement_history>`,
+		`<conversation>\n${conversationText}\n</conversation>`,
+		`<scope>\n${scopeInst}\n</scope>`,
+		options.instructions ? `<instructions>\n${options.instructions}\n</instructions>` : "",
+		"Return only JSON edits. If no edit is justified, return empty edits array with rationale.",
+	].filter(Boolean).join("\n\n");
+
+	const context: Context = {
+		systemPrompt: REFINEMENT_SYSTEM_PROMPT,
+		messages: [{ role: "user", content: [{ type: "text", text: userPrompt }], timestamp: Date.now() }],
+	};
+
+	const response = await completeSimple(model, context);
+
+	if (response.stopReason === "error") {
+		throw new Error(`Refinement failed: ${response.errorMessage ?? "Unknown error"}`);
+	}
+	if (response.stopReason === "length") {
+		throw new Error("Refinement failed: model output truncated");
+	}
+
+	const text = response.content
+		.filter((c): c is { type: "text"; text: string } => c.type === "text")
+		.map((c) => c.text)
+		.join("\n");
+
+	return { proposal: parseProposal(text), id };
+}
+
+export async function refineHarness(
+	messages: Array<{ role: string; content: unknown }>,
+	state: HarnessState,
+	history: RefinementResult[],
+	model: Model<Api>,
+	options: RefineOptions = {},
+): Promise<RefinementResult> {
+	const plan = await planRefinement(messages, state, history, model, options);
+	return applyRefinementProposal(state, plan.proposal, {
+		id: plan.id,
+		rollbackOf: plan.rollbackOf,
+		scope: plan.rollbackScope ?? (options.global ? "global" : "local"),
+	});
+}
