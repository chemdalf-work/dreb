+// SPDX-License-Identifier: MIT
+// Port of open-code-review's internal/diff/resolver.go + hunk.go (Apache-2.0)
+// See: https://github.com/alibaba/open-code-review
+
+// ── Types ───────────────────────────────────────────────────────────────────
+
+export interface DiffComment {
+	path: string;
+	content: string;
+	suggestionCode?: string;
+	existingCode: string;
+	startLine: number;
+	endLine: number;
+	thinking?: string;
+	category?: string;
+	severity?: string;
+}
+
+/** Represents one side of a unified diff for a single file. */
+export interface DiffFile {
+	newPath: string;
+	oldPath: string;
+	diff: string; // raw unified diff text
+	newFileContent: string; // full new-file content
+}
+
+export enum HunkLineType {
+	Context = 0,
+	Added = 1,
+	Deleted = 2,
+}
+
+export interface HunkLine {
+	type: HunkLineType;
+	content: string; // without the leading + / - / space marker
+}
+
+export interface Hunk {
+	oldStart: number; // 1-indexed
+	oldCount: number;
+	newStart: number; // 1-indexed
+	newCount: number;
+	lines: HunkLine[];
+}
+
+// ── Hunk Parsing ────────────────────────────────────────────────────────────
+
+const hunkHeaderRe = /^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@/;
+
+export function parseHunks(rawDiffText: string): Hunk[] {
+	const lines = rawDiffText.split("\n");
+	const hunks: Hunk[] = [];
+	let current: Hunk | null = null;
+
+	for (const line of lines) {
+		const m = hunkHeaderRe.exec(line);
+		if (m) {
+			// Flush previous hunk
+			if (current) hunks.push(current);
+
+			const oldStart = parseInt(m[1], 10);
+			const oldCount = m[2] ? parseInt(m[2], 10) : 1;
+			const newStart = parseInt(m[3], 10);
+			const newCount = m[4] ? parseInt(m[4], 10) : 1;
+
+			current = { oldStart, oldCount, newStart, newCount, lines: [] };
+			continue;
+		}
+
+		if (!current) continue; // skip file-level headers
+
+		// Skip metadata lines inside hunks
+		if (line.startsWith("\\ No newline at end of file")) continue;
+
+		// Stop if we hit another file's diff header
+		if (line.startsWith("diff --git ")) break;
+
+		if (line === "") continue; // skip trailing empty lines from split
+		if (line.startsWith("+")) {
+			current.lines.push({ type: HunkLineType.Added, content: line.slice(1) });
+		} else if (line.startsWith("-")) {
+			current.lines.push({ type: HunkLineType.Deleted, content: line.slice(1) });
+		} else {
+			// Context line (' ' prefix) or other — treat as context
+			const content = line[0] === " " ? line.slice(1) : line;
+			current.lines.push({ type: HunkLineType.Context, content });
+		}
+	}
+
+	if (current) hunks.push(current);
+	return hunks;
+}
+
+// ── Normalization helpers ───────────────────────────────────────────────────
+
+function normalizeLine(s: string): string {
+	s = s.trim();
+	if (s.startsWith("+")) s = s.slice(1).trim();
+	if (s.startsWith("-")) s = s.slice(1).trim();
+	return s.trim();
+}
+
+function splitAndNormalize(code: string): string[] {
+	return code
+		.split("\n")
+		.map(normalizeLine)
+		.filter((line) => line !== "");
+}
+
+// ── Side extraction ─────────────────────────────────────────────────────────
+
+interface IndexedLine {
+	lineNum: number;
+	content: string;
+}
+
+function extractSideLines(hunk: Hunk, newSide: boolean): IndexedLine[] {
+	const result: IndexedLine[] = [];
+	let oldLine = hunk.oldStart;
+	let newLine = hunk.newStart;
+
+	for (const l of hunk.lines) {
+		switch (l.type) {
+			case HunkLineType.Context:
+				result.push({
+					lineNum: newSide ? newLine : oldLine,
+					content: normalizeLine(l.content),
+				});
+				oldLine++;
+				newLine++;
+				break;
+			case HunkLineType.Added:
+				if (newSide) {
+					result.push({ lineNum: newLine, content: normalizeLine(l.content) });
+				}
+				newLine++;
+				break;
+			case HunkLineType.Deleted:
+				if (!newSide) {
+					result.push({ lineNum: oldLine, content: normalizeLine(l.content) });
+				}
+				oldLine++;
+				break;
+		}
+	}
+	return result;
+}
+
+// ── Matching ────────────────────────────────────────────────────────────────
+
+function matchConsecutive(
+	sideLines: IndexedLine[],
+	targetLines: string[],
+): { start: number; end: number; ok: boolean } {
+	if (targetLines.length === 0 || sideLines.length < targetLines.length) {
+		return { start: 0, end: 0, ok: false };
+	}
+
+	for (let i = 0; i <= sideLines.length - targetLines.length; i++) {
+		let matched = true;
+		for (let j = 0; j < targetLines.length; j++) {
+			if (sideLines[i + j].content !== targetLines[j]) {
+				matched = false;
+				break;
+			}
+		}
+		if (matched) {
+			return {
+				start: sideLines[i].lineNum,
+				end: sideLines[i + targetLines.length - 1].lineNum,
+				ok: true,
+			};
+		}
+	}
+	return { start: 0, end: 0, ok: false };
+}
+
+// ── Resolution ──────────────────────────────────────────────────────────────
+
+function resolveFromHunk(d: DiffFile, cm: DiffComment): boolean {
+	const hunks = parseHunks(d.diff);
+	if (hunks.length === 0) return false;
+
+	const targetLines = splitAndNormalize(cm.existingCode);
+	if (targetLines.length === 0) return false;
+
+	// Try new-side first (context + added → new-file line numbers)
+	for (const hunk of hunks) {
+		const newSide = extractSideLines(hunk, true);
+		const { start, end, ok } = matchConsecutive(newSide, targetLines);
+		if (ok) {
+			cm.startLine = start;
+			cm.endLine = end;
+			return true;
+		}
+	}
+
+	// Fall back to old-side (context + deleted → old-file line numbers)
+	for (const hunk of hunks) {
+		const oldSide = extractSideLines(hunk, false);
+		const { start, end, ok } = matchConsecutive(oldSide, targetLines);
+		if (ok) {
+			cm.startLine = start;
+			cm.endLine = end;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+function resolveFromFileContent(d: DiffFile, cm: DiffComment): boolean {
+	if (!d.newFileContent) return false;
+
+	const fileLines = d.newFileContent.split("\n");
+	const targetLines = splitAndNormalize(cm.existingCode);
+	if (targetLines.length === 0) return false;
+
+	// Normalize file lines: skip blanks, track original line numbers
+	const normalizedLines: string[] = [];
+	const fileLineNums: number[] = [];
+	for (let i = 0; i < fileLines.length; i++) {
+		const n = normalizeLine(fileLines[i].replace(/\r$/, ""));
+		if (n === "") continue;
+		normalizedLines.push(n);
+		fileLineNums.push(i + 1);
+	}
+
+	if (normalizedLines.length < targetLines.length) return false;
+
+	for (let i = 0; i <= normalizedLines.length - targetLines.length; i++) {
+		let matched = true;
+		for (let j = 0; j < targetLines.length; j++) {
+			if (normalizedLines[i + j] !== targetLines[j]) {
+				matched = false;
+				break;
+			}
+		}
+		if (matched) {
+			cm.startLine = fileLineNums[i];
+			cm.endLine = fileLineNums[i + targetLines.length - 1];
+			return true;
+		}
+	}
+
+	return false;
+}
+
+// ── Public API ──────────────────────────────────────────────────────────────
+
+/**
+ * Resolves StartLine/EndLine on each comment by matching existingCode against
+ * the corresponding file's diff hunks (primary), or falling back to scanning
+ * the full new-file content line-by-line.
+ */
+export function resolveLineNumbers(comments: DiffComment[], diffs: DiffFile[]): DiffComment[] {
+	if (comments.length === 0 || diffs.length === 0) return comments;
+
+	// Build lookup: path -> DiffFile
+	const diffByPath = new Map<string, DiffFile>();
+	for (const d of diffs) {
+		if (d.newPath && d.newPath !== "/dev/null") diffByPath.set(d.newPath, d);
+		if (d.oldPath && d.oldPath !== "/dev/null") diffByPath.set(d.oldPath, d);
+	}
+
+	const result = comments.map((cm) => ({ ...cm }));
+
+	for (const cm of result) {
+		if (cm.startLine > 0 || cm.endLine > 0) continue;
+		if (!cm.existingCode) continue;
+
+		const d = diffByPath.get(cm.path);
+		if (!d) continue;
+
+		// Primary: match from diff hunks
+		if (resolveFromHunk(d, cm)) continue;
+
+		// Fallback: scan full file content
+		resolveFromFileContent(d, cm);
+	}
+
+	return result;
+}
+
+/**
+ * Attempts to resolve startLine/endLine for a single comment by matching
+ * existingCode against the diff. Returns true on success.
+ */
+export function resolveComment(cm: DiffComment, d: DiffFile): boolean {
+	if (cm.startLine > 0 || cm.endLine > 0) return true;
+	if (!cm.existingCode) return false;
+	if (resolveFromHunk(d, cm)) return true;
+	return resolveFromFileContent(d, cm);
+}
+
+/**
+ * Relocate comments whose existingCode belongs to a different file than the
+ * one it was filed against. Uses deterministic string matching — no LLM.
+ * Returns the new path and true on a unique hit; false on zero or multiple hits.
+ */
+export function relocateAcrossFiles(
+	cm: DiffComment,
+	diffs: DiffFile[],
+): { path: string; ok: boolean } {
+	if (!cm || !cm.existingCode || diffs.length === 0) return { path: "", ok: false };
+
+	let hit: { path: string; start: number; end: number } | null = null;
+
+	for (const d of diffs) {
+		if (d.newPath === cm.path || d.oldPath === cm.path) continue;
+
+		const probe: DiffComment = { ...cm, startLine: 0, endLine: 0 };
+		if (!resolveComment(probe, d)) continue;
+
+		const path = d.newPath || d.oldPath;
+		if (hit) return { path: "", ok: false }; // ambiguous — decline
+		hit = { path, start: probe.startLine, end: probe.endLine };
+	}
+
+	if (!hit) return { path: "", ok: false };
+
+	cm.path = hit.path;
+	cm.startLine = hit.start;
+	cm.endLine = hit.end;
+	return { path: hit.path, ok: true };
+}
